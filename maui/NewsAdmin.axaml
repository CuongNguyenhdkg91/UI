<UserControl xmlns = "https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="maui.NewsAdmin"
        Background="#F5EAEA"
        FontFamily="Gabriola"
        >
             
    <Grid>
        <!-- want to make a header with buttons and then a main content area with two columns, one for news and one for images -->
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5" HorizontalAlignment="Right">
            <Button Content="Save" Margin="0,0,5,0" Click="FormatWriting"/>
            <Button Content="Edit" Margin="0,0,5,0" Click="UpdateNews"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="NewsLayoutContainer" Orientation="Horizontal" Grid.Column="0">
                    
                <WrapPanel Margin="5">
                    <!-- <ContentControl Content="{Binding ButtonCollection}" /> -->

                    <!-- <ContentControl Content="{Binding, Source={StaticResource ButtonCollectionSource}}" /> -->
                    <!-- <ContentControl Content="{Binding, Source={StaticResource LoginSource}}" /> -->

                    <!-- <local:ButtonCollection /> -->

                    <!-- <ContentControl Content="{Binding Login}" /> -->
                </WrapPanel>
                <StackPanel x:Name= "EditNewsLayoutContainer" Margin="5">
                    <TextBlock Text="Write your paragraph:"/>
                    <TextBox 
                            x:Name="Writing"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Width="1000"
                            Height="500"
                            FontSize="20"
                            FontFamily="Calibri"
                            Watermark="Type your text here..." />
                    <TextBox x:Name="KeyWords" TextWrapping="Wrap" FontSize="20" FontFamily="Calibri" />
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Submit" Margin="0,10,0,0" Width="100" HorizontalAlignment="Left" />
                        <Button Content="Clean Paragraph" Margin="0,10,0,0" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Column="1" Margin="5" VerticalScrollBarVisibility = "Auto" HorizontalScrollBarVisibility = "Disabled">   
                <StackPanel Margin="20" Grid.Column="1" Orientation="Vertical" x:Name="ImageLayoutContainer">
                    <!-- Square upload box -->
                    <Border x:Name="UploadBox"
                            Width="200"
                            Height="200"
                            BorderBrush="Gray"
                            BorderThickness="2"
                            Background="LightGray"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            PointerPressed="OnUploadClick">
                        <TextBlock Text="Click to upload"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="DarkGray"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

             
</UserControl>